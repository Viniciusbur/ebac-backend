algoritmo "Acordar_AbrirOlho_Levantar"
inicio
   escreva("O alarme toca...\n")
   escreva("Você acordou.\n")
   escreva("Você abre os olhos lentamente...\n")
   
   escreva("Deseja levantar? (s/n): ")
   leia(resposta)

   se resposta = "s" entao
      escreva("Você se levantou da cama.\n")
   senao
      escreva("Você decidiu ficar mais um pouco na cama.\n")
   fimse
fim